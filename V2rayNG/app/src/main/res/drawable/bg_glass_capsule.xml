<?xml version="1.0" encoding="utf-8"?>
<!--  Cosmic glass capsule background for floating panels.
      Draws a rounded translucent dark surface with a subtle stroke. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="#CC0A0813" />
    <corners android:radius="28dp" />
    <stroke
        android:width="1dp"
        android:color="#33B388FF" />
</shape>